NEXT_PUBLIC_API_URL=http://localhost:3001
# Doit correspondre à VAPID_PUBLIC_KEY côté apps/api/.env (clé publique uniquement).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optionnel, dev uniquement — pour tester depuis un autre appareil du réseau local
# (téléphone, etc.), IP(s) séparées par des virgules. Voir next.config.mjs.
DEV_ALLOWED_ORIGINS=
